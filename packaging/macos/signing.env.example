# Copy to signing.env (gitignored) for release builds on your Mac.
# REAPER_SIGN_IDENTITY is also auto-detected from Keychain when unset.

REAPER_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
REAPER_APPLE_TEAM_ID="TEAMID"
REAPER_APPLE_ID="you@example.com"

# Optional — only when AC_NOTARY is stored in Keychain:
# REAPER_NOTARY_KEYCHAIN_PROFILE=AC_NOTARY
# REAPER_NOTARIZE=1
